    },
    {
      "id": "n4",
      "x": 1040,
      "y": 300,
      "text": "PCA9685 V+ = 6V buck szervo-sin (XH-M401).\n18 szervo: 0x40 CH0-CH8 + 0x41 CH0-CH8.\nDS3225MG 180°, 50 Hz.",
      "color": "#99561a"
    },
    {
      "id": "n5",
